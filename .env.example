# ============================================================
# Vive Gostoso — Environment Variables
# ============================================================
# Copy this to .env.local and fill in the values.
# Get these from: Supabase Dashboard, Stripe Dashboard,
# GitHub Settings, and Vercel Dashboard.

# ============================================================
# Supabase (obrigatório para o site funcionar)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# Supabase MCP — Conexão direta ao banco PostgreSQL
# Usado pelo MCP server para rodar queries e migrations.
# A string de conexão está em:
# Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Substitua [YOUR-PASSWORD] pela senha do banco.
# ============================================================
# SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ============================================================
# Stripe MCP — Gerenciar produtos, preços e pagamentos
# A chave secreta está em: Stripe Dashboard > Developers > API Keys
# Use a Secret Key (sk_live_...), NÃO a Publishable Key.
# ============================================================
# STRIPE_SECRET_KEY=sk_live_...

# ============================================================
# GitHub MCP — Issues, PRs, repositórios
# Token em: GitHub Settings > Developer settings > Personal access tokens
# Permissões necessárias: repo, issues, pull_requests
# ============================================================
# GITHUB_TOKEN=ghp_...

# ============================================================
# Mapbox (obrigatório para o mapa Explore funcionar)
# ============================================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# ============================================================
# Google Tag Manager (opcional — só ativa se preenchido)
# ============================================================
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
