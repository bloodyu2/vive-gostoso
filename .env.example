# ============================================================
# Vive Gostoso — Environment Variables
# ============================================================
# Copy this to .env.local and fill in the values.
# Get these from: Supabase Dashboard,
# GitHub Settings, and Vercel Dashboard.

# ============================================================
# Supabase (obrigatório para o site funcionar)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# Supabase MCP — Conexão direta ao banco PostgreSQL
# Usado pelo MCP server para rodar queries e migrations.
# A string de conexão está em:
# Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Substitua [YOUR-PASSWORD] pela senha do banco.
# ============================================================
# SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ============================================================
# GitHub MCP — Issues, PRs, repositórios
# Token em: GitHub Settings > Developer settings > Personal access tokens
# Permissões necessárias: repo, issues, pull_requests
# ============================================================
# GITHUB_TOKEN=ghp_...

# ============================================================
# Mapbox (obrigatório para o mapa Explore funcionar)
# ============================================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# ============================================================
# Google Tag Manager (opcional — só ativa se preenchido)
# ============================================================
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX


# Canal de ofertas (KAN-743). Ligado por padrão com o canal oficial; as variáveis só sobrescrevem.
# NEXT_PUBLIC_OFERTAS_ATIVAS=false
# NEXT_PUBLIC_CANAL_OFERTAS_URL=https://...

# ============================================================
# Pergunta "voce usou o cupom?" do Passaporte (KAN-896)
# DESLIGADA por padrao. So envia com CLUBE_PERGUNTA_ATIVA=1 e tudo abaixo preenchido.
# Vercel Cron chama /api/clube/perguntar as 09:00 de Gostoso (12:00 UTC), com o CRON_SECRET.
# Segredos de producao: quem poe na Vercel e o Victor.
# ============================================================
# CLUBE_PERGUNTA_ATIVA=1
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CLUBE_PERGUNTA_REMETENTE="Vive Gostoso <contato@vivegostoso.com.br>"
